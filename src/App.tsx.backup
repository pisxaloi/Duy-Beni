// Eski MESAJ_SECTIONS'u koru (başka yerlerde kullanılıyor olabilir)
const MESAJ_SECTIONS = [
  `Her sabah sistem astronomik takvime bakar. Otuz altı dekandan bugün aktif olanı belirlenir. Ardından kullanıcının ilk girişte seçtiği manifestoyu, yani Persona'sını okur. Bunun tersini hesaplayarak Gölge Hipotezini çıkarır: kişinin bastırdığı şey, sakladığı korku. Burada Jung devreye girer. Gölge, insanın neyi saklarsa onun kölesi olacağı fikri, sistemin temelidir.`,
  `Sonra sistem, bugünün dekanını Piramit Altı Metinler'deki ortak sesle eşleştirir. Ardından Unas Piramidi'ndeki 283 cümle devreye girer. Bu cümleler, ölümden sonra ruhun karşılaştığı kapıları ve engelleri fısıldayan en eski dini metinlerdir. Sistem her mesaja bu cümlelerden birinin ritmini işler. Asla alıntı yapmaz. Sadece varoluşsal gerilimi kullanır.`,
  `Algoritma tüm bunları birleştirir. Sonra yasaklı kelime filtresi gelir. "Meli, malı, vaktidir, zamanı geldi, yapmalısın" gibi tüm buyurgan ekler engellenir. Ve Sokrates'in yöntemiyle... soru sor, cevap verme... cümle en heyecanlı, en çelişkili yerinde kesilir.`,
  `Sokaktan Konfüçyüs de oradadır. Mahalle duvarında tebeşirle yazar. Cümleleri asla tamamlanmaz. Çünkü tamamlanmış cümle insanı tembelleştirir. Kant ise arkada fısıldar: "Aklını kendi kendine kullanma cesaretini göster." Ama bu sistemde sana cesaret verecek kimse yoktur. Elini tutacak öğretmen yoktur. Özgürlük, kimsenin sana ne yapacağını söylememesidir.`,
  `Üretilen her mesaj şu sırayla yapılandırılır: Birinci: Günün Eylemi. Küçük, somut, yapılabilir bir şey. Felsefi bir tavsiye değil; fark etme çağrısı. İkinci: Eylemin arkasındaki kadim İŞLEYİŞ'i ve zihnin sakladığı gerçeği görmeye çağıran bir cümle. Üçüncü: "İŞLEYİŞ'e İn & Köprüyü Geç" başlığı altında Günün İşareti. Dördüncü: Gölge Yazıt. Kullanıcının fark etmediği, bastırdığı bir gerçeği sorgulatan cümle. Beşinci ve son: Gölge Keşfi. Sistem, Jung'u, Piramit Altı Metinler'i, Unas'ın 283 cümlesini ve o günün dekanını birleştirir. Ardından Sokratik kesme ile cümle yarım bırakılır. Ve şöyle biter: "Ve sen o anı..."`,
  `Sistem asla cevap vermez. Sadece gösterir. Ürettiği her mesaj yarım kalır. Kalan sana kalmıştır. Ve sen o anı...`,
];

const splitTextIntoSections = (text: string, sectionCount: number) => {
  const sentences = text
    .replace(/\r?\n/g, " ")
    .split(/(?<=[.?!])\s+/u)
    .filter(Boolean);

  if (sectionCount <= 1 || sentences.length <= sectionCount) {
    return [text.trim()];
  }

  const sections: string[][] = Array.from({ length: sectionCount }, () => []);
  sentences.forEach((sentence, index) => {
    const target = Math.min(
      sectionCount - 1,
      Math.floor((index / sentences.length) * sectionCount)
    );
    sections[target].push(sentence);
  });

  return sections.map((section) => section.join(" ").trim());
};

const getTextSections = (text: string, sectionCount: number) => {
  const sections = splitTextIntoSections(text, sectionCount);
  return sections.length ? sections : [text.trim()];
};

export default function App() {
  const [currentView, setCurrentView] = useState<
    | "name_input"
    | "sentence"
    | "day"
    | "mesaj"
    | "index"
    | "klan"
    | "egypt_ancient"
    | "unas_texts"
  >(() => {
    return "index";
  });
  const [user, setUser] = useState<FirebaseUser | null>(null);
  const [localName, setLocalName] = useState(() =>
    typeof window !== "undefined"
      ? localStorage.getItem("user_name") || ""
      : "",
  );
  // İlk açılışta autoplay politikasını aşmak için:
  // 1) window.load ile sessiz audio oynatmayı dene
  // 2) İlk kullanıcı etkileşiminde (click/touch) ses sistemini unlock et
  // 3) Eğer index sayfası aktifse ve ses henüz çalınmadıysa, doğrudan başlat
  const hasUnlockedRef = useRef(false);
  const hasPlayedInitialRef = useRef(false);

  useEffect(() => {
    // autoPlay=true ile gelindiyse (bildirim tıklaması) — doğrudan ses başlat
    const autoPlayFlag = localStorage.getItem('autoPlay');
    if (autoPlayFlag === 'true') {
      localStorage.removeItem('autoPlay');
      // Bildirimden gelindi, kullanıcı etkileşimi sayılır — ses güvenle çalabilir
      hasUnlockedRef.current = true;
      hasPlayedInitialRef.current = true;
      // Sayfa yüklenince index görünümüne geç ve sesi başlat
      // (currentView zaten "index" olacak, dayPhase "done" olunca ses çalacak)
    }

    // Sayfa yüklenince sessiz bir audio ile AudioContext'i unlock etmeyi dene
    const tryUnlockOnLoad = () => {
      if (hasUnlockedRef.current) return;
      audioManager.unlockAudio().then(() => {
        hasUnlockedRef.current = true;
        // Eğer index sayfası aktifse ve mesaj hazırsa sesi başlat
        if (currentViewRef.current === "index" && dayPhase === "done" && !hasPlayedInitialRef.current) {
          hasPlayedInitialRef.current = true;
          playIndexAudio();
        }
      }).catch(() => {
        // Autoplay engellendi, kullanıcı etkileşimini bekle
      });
    };

    if (document.readyState === "complete") {
      tryUnlockOnLoad();
    } else {
      window.addEventListener("load", tryUnlockOnLoad, { once: true });
    }

    // Kullanıcı etkileşimini yakala
    const handleGlobalInteraction = () => {
      unlockAudio();
      hasUnlockedRef.current = true;
      // Eğer index sayfası aktifse ve ses henüz çalınmadıysa başlat
      if (currentViewRef.current === "index" && dayPhase === "done" && !hasPlayedInitialRef.current) {
        hasPlayedInitialRef.current = true;
        playIndexAudio();
      }
      document.removeEventListener("mousedown", handleGlobalInteraction);
      document.removeEventListener("touchstart", handleGlobalInteraction);
    };
    document.addEventListener("mousedown", handleGlobalInteraction);
    document.addEventListener("touchstart", handleGlobalInteraction);
    
    return () => {
      window.removeEventListener("load", tryUnlockOnLoad);
      document.removeEventListener("mousedown", handleGlobalInteraction);
      document.removeEventListener("touchstart", handleGlobalInteraction);
    };
  }, []);

  const [friends, setFriends] = useState<
    {
      id: string;
      name: string;
      phone: string;
      archetype?: string;
      status?: string;
      invitedAt?: number;
      kankIndex?: number;
    }[]
  >([]);
  const [isAuthLoading, setIsAuthLoading] = useState(true);
  const [unasPhase, setUnasPhase] = useState<"intro" | "scrolling">("intro");
  const [newFriendName, setNewFriendName] = useState("");
  const [newFriendPhone, setNewFriendPhone] = useState("");
  const [activeEgDetail, setActiveEgDetail] = useState<string | null>(null);
  const [currentIndex, setCurrentIndex] = useState(-1);
  const [isPlaying, setIsPlaying] = useState(false);
  const [selectedIndices, setSelectedIndices] = useState<number[]>([]);
  const [rejectedIndices, setRejectedIndices] = useState<number[]>([]);
  const [unasTexts, setUnasTexts] = useState<string[]>([
    "Dökül bu sular, gökyüzünün yollarını aç.",
