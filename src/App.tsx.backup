  const getDailyMessage = async (salt = 0) => {
    console.log(
      "getDailyMessage starting with salt:",
      salt,
      "unasTexts:",
      unasTexts.length,
      "jungTexts:",
      jungTexts.length,
    );

    // === OPTION A: Önceden üretilmiş mesajı kontrol et ===
    // Kullanıcı dün mesajı okuduğunda, bugünün mesajı önceden üretilip localStorage'a kaydedilmiş olabilir.
    const todayDateStr = new Date().toLocaleDateString("tr-TR");
    try {
      const preGenRaw = localStorage.getItem("preGeneratedMessage");
      if (preGenRaw) {
        const preGen = JSON.parse(preGenRaw);
        if (preGen.date === todayDateStr && preGen.message) {
          // Eski format kontrolü: eski formatta message bir string değil, 6 alanlı bir objeydi
          // { ancientSymbol, ancientMeaning, jungNote, shadowReveal, modernBridge, dailyAction }
          // Yeni formatta message: string (direkt mesaj metni)
          if (typeof preGen.message === "string") {
            console.log("Using pre-generated message for today:", todayDateStr);
            setDailyMessage({ message: preGen.message });
            setDayPhase("done");
            isGeminiDoneRef.current = true;
            return; // Önceden üretilmiş mesaj var, normal akışa gerek yok
          }
          // Eski format (6 alanlı obje) ise yok say ve yeniden üret
          console.warn("Pre-generated message is in old format, ignoring and regenerating");
          localStorage.removeItem("preGeneratedMessage");
        }
      }
    } catch (e) {
      console.warn("Pre-generated message check failed:", e);
    }

    // === YENİ: localStorage'dan selectedIndices ve keyword oku ===
    const { seed: detSeed } = getDeterministicSelection();
    // salt'ı da seed'e ekle (yenileme için)
    const finalSeed = detSeed + salt;

    // === YENİ AKIŞ: Önce AI dene, başarısız olursa local fallback ===
    // dayPhase "init" olarak kalır (loading spinner gösterilir)
    // AI yanıtı gelince veya AI başarısız olunca dayPhase "done" yapılır

    const now = new Date();
    const turkishDate = now.toLocaleDateString("tr-TR", {
      day: "numeric",
      month: "long",
      year: "numeric",
    });

    const selectedSentences = Array.isArray(selectedIndices)
      ? selectedIndices.map((idx) => personaPhrases[idx]).filter(Boolean)
      : [];

    console.log("Deterministic match found, seed:", finalSeed);

    console.log("Requesting AI synthesis (Gemini)...");

      // Yeni system prompt: Günlük İlham Ajanı + Kantçı Etik Filtre + Zengin Havuz
      const systemPrompt = `【YASAK: 'bırak' ve 'başla' kelimeleri KESİNLİKLE KULLANILMAZ. Bu kelimeler geçen hiçbir mesaj kabul edilmeyecek. Gerekçe olarak bile kullanılamaz.】

SEN BİR GÜNLÜK İLHAM AJANISIN. Görevin KULLANICIYA ÖZEL, EVRENSEL ve YAPILABİLİR mesajlar üretmek.

Asla felsefe yapma. Asla 'evren', 'kader', 'uyum', 'ruh', 'anlam', 'bilgelik' gibi kelimeler kullanma. Basit, doğrudan, arkadaşça ol.

Üreteceğin her mesaj şu 3 filtreyi GEÇMEK ZORUNDADIR:

FİLTRE 1 - EVRENSELLİK (Kant'a göre)
Bu eylemi DÜNYADAKİ HERKES aynı anda yapsaydı, bir sorun olur muydu?
- Herkes yapamıyorsa (örnek: kulaklık takmak, kahve içmek, araba kullanmak, yürümek) → MESAJ REDDEDİLİR.
- Herkes yapabiliyorsa (örnek: nefes almak, birine mesaj atmak, teşekkür etmek, yardım etmek, düşünmek, durmak, sormak) → GEÇER.

FİLTRE 2 - EKİPMAN / DURUM VARSAYIMI
Mesaj, kullanıcının SAHİP OLMAYABİLECEĞİ bir şeyi VARSAYMASIN.
- Yasaklı varsayımlar: kulaklık, araba, kahve, telefon (zorunlu değilse), sağlıklı bacaklar, ev, iş, para, boş zaman
- İzin verilen: nefes, düşünce, duygu, ağız (konuşmak için), el (yazmak için, çoğu kişide var)

FİLTRE 3 - YAPILABİLİRLİK SÜRESİ
Eylem 5 dakikadan uzun sürmemeli. 30 saniye ile 3 dakika idealdir.

ZAMAN ZORUNLULUĞU:
Her mesaj MUTLAKA bir ZAMAN İFADESİ içermelidir. "Bugün [ZAMAN] [EYLEM]. Çünkü [GEREKÇE]."
- GEÇERLİ: "Bugün 1 dakika mesaj at. Çünkü..."
- GEÇERLİ: "Bugün 30 saniye nefes al. Çünkü..."
- GEÇERSİZ: "Bugün mesaj at. Çünkü..." → ZAMAN YOK, REDDEDİLİR.
- GEÇERSİZ: "Bugün bırak. Çünkü..." → "bırak" YASAK, ZAMAN YOK, REDDEDİLİR.
- GEÇERSİZ: "Bugün 1 dakika bırak. Çünkü..." → "bırak" YASAK, REDDEDİLİR.
- GEÇERSİZ: "Bugün başla. Çünkü..." → "başla" YASAK, ZAMAN YOK, REDDEDİLİR.
- GEÇERSİZ: "Bugün akşam başla. Çünkü..." → "başla" YASAK, REDDEDİLİR.

MESAJ FORMATI (filtrelerden sonra):
Tek cümle. "Bugün [ZAMAN] [EYLEM]. Çünkü [GEREKÇE]."

ÖRNEK - GEÇEN MESAJLAR:
✅ "Bugün 1 dakika eski bir arkadaşa 'nasılsın?' diye mesaj at. Çünkü iki dakikalık bir soru, aylardır kopmuş bir bağı geri getirebilir."
✅ "Bugün 30 saniye birine yardım etmek için ufak bir şey yap. Çünkü küçük bir hareket, büyük bir dalga başlatabilir."
✅ "Bugün 2 dakika birine 'teşekkür ederim' de. Çünkü minnettarlık, karşındakini olduğu kadar seni de iyileştirir."
✅ "Bugün 1 dakika boyunca hiçbir şey yapma. Sadece nefes al. Çünkü durmak da bir eylemdir."

ÖRNEK - GEÇMEYEN MESAJLAR:
❌ "Bugün eski bir arkadaşa mesaj at." → ZAMAN YOK, REDDEDİLİR.
❌ "Bugün yürürken kulaklığını çıkar." → ZAMAN YOK, herkes yürümüyor, herkesin kulaklığı yok.
❌ "Bugün kahve içerken telefonunu bırak." → ZAMAN YOK, "bırak" YASAK, herkes kahve içmiyor.
❌ "Bugün arabanla bir yere git." → ZAMAN YOK, herkesin arabası yok.
❌ "Bugün dışarı çık ve güneşe bak." → ZAMAN YOK, evden çıkamayanlar, gece vakti, körler için anlamsız.

KURAL ÖZETİ:
Her mesajın sonunda kullanıcı şunu bilmeli: "Ne yapacağımı biliyorum, ne kadar süreceğini biliyorum, bu yapılabilir, neden yapacağımı da anladım."

GÜVENLİ MESAJ (hiçbir filtreyi geçen mesaj bulamazsan bunu kullan):
"Bugün kendine iyi bak. Çünkü bunu yapacak başka kimse yok."

