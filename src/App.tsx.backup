    { eylem: "yaz", hedefler: ["bir hikaye", "bir şiir", "bir şarkı sözü", "bir senaryo", "bir günlük", "bir mektup", "bir manifesto"], gerekceler: ["yazmak düşünceleri ölümsüzleştirir", "herkesin içinde yazılmayı bekleyen bir hikaye vardır", "yazmak kendini ifade etmenin en özgür yoludur", "kelimeler dünyaları değiştirebilir"] },
    { eylem: "tasarla", hedefler: ["bir alanı", "bir objeyi", "bir sistemi", "bir süreci", "bir günü", "bir hayatı"], gerekceler: ["tasarlamak hayal gücünü şekillendirmektir", "iyi bir tasarım hayatı kolaylaştırır", "tasarlamak düzen ve estetiği birleştirmektir", "her şey yeniden tasarlanabilir"] },
  ];

  // KATEGORİ 9: DOĞA / ÇEVRE
  const dogaKategori = [
    { eylem: "çık dışarı", hedefler: ["bir yürüyüşe", "temiz hava almaya", "güneşi görmeye", "bir parka", "deniz kenarına", "bir ormana", "bir tepeye"], gerekceler: ["doğa ruhu onarır", "dışarıdaki her şey bir süre sonra seninle ilgili olmaktan çıkar", "doğada olmak insan olduğunu hatırlatır", "temiz hava zihni açar"] },
    { eylem: "gözlemle", hedefler: ["bir ağacı", "bir kuşu", "bir böceği", "bir çiçeği", "bir yaprağı", "bir bulutu", "bir gün batımını"], gerekceler: ["doğayı gözlemlemek sabrı öğretir", "her canlıda bir bilgelik saklıdır", "doğa en büyük öğretmendir", "küçük şeylerdeki büyük güzelliği fark etmek bir sanattır"] },
    { eylem: "ek", hedefler: ["bir tohum", "bir fikir", "bir bitki", "bir çiçek", "bir ağaç", "bir umut", "bir iyilik"], gerekceler: ["ekmek geleceğe yatırım yapmaktır", "bir tohum bin ağaç olabilir", "ektiğini biçmek sabrın ödülüdür", "ekmek umut etmektir"] },
    { eylem: "temizle", hedefler: ["bir alanı", "bir sahili", "bir parkı", "bir ormanı", "çevreni", "bir su kaynağını"], gerekceler: ["doğayı temizlemek kendine bakmaktır", "bir parça çöp bir ömür boyu doğada kalır", "çevreni temiz tutmak saygının en somut halidir", "temiz bir çevre temiz bir zihin demektir"] },
    { eylem: "dinle", hedefler: ["rüzgarı", "yağmuru", "denizi", "kuşları", "bir derenin sesini", "yaprakların hışırtısını"], gerekceler: ["doğanın sesi ruhu onarır", "rüzgarın fısıltısında cevaplar saklıdır", "doğanın ritmi insanın ritmidir", "her ses bir frekans her frekans bir şifadır"] },
    { eylem: "dokun", hedefler: ["toprağa", "bir ağaca", "bir çiçeğe", "bir yaprağa", "bir taşa", "bir suya"], gerekceler: ["dokunmak bağ kurmanın en eski yoludur", "toprağa dokunmak insanı dünyaya bağlar", "dokunmak hissetmenin en saf halidir", "bir dokunuş bin kelimeden daha derindir"] },
  ];

  // KATEGORİ 10: İLİŞKİLER / BAĞLAR
  const iliskilerKategori = [
    { eylem: "bağ kur", hedefler: ["bir dostla", "ailenle", "bir yabancıyla", "bir hayvanla", "bir çocukla", "bir yaşlıyla", "kendinle"], gerekceler: ["bağ kurmak insan olmanın en temel ihtiyacıdır", "her bağ seni biraz daha bütün yapar", "bağ kurmak yalnızlığı iyileştirir", "gerçek bağlar zamanla derinleşir"] },
    { eylem: "sarıl", hedefler: ["bir dostuna", "ailenden birine", "sevdiğine", "bir çocuğa", "kendine", "bir anıya"], gerekceler: ["bir kucaklama bin kelimeden daha fazlasını anlatır", "sarılmak iyileştirir", "sarılmak ait olmanın en eski dilidir", "bir sarılma bir günü değiştirebilir"] },
    { eylem: "teşekkür et", hedefler: ["bir arkadaşına", "bir öğretmene", "bir ebeveyne", "bir yabancıya", "bir hayvana", "hayata", "kendine"], gerekceler: ["teşekkür etmek bağları güçlendirir", "minnettarlık bulaşıcıdır", "bir teşekkür bir ömür hatırlanır", "teşekkür etmek alçakgönüllülüğün en güzel halidir"] },
    { eylem: "yardım et", hedefler: ["bir ihtiyacı olana", "bir arkadaşına", "bir yabancıya", "bir hayvana", "bir yaşlıya", "bir çocuğa"], gerekceler: ["yardım etmek insan olmanın en yüce halidir", "bir iyilik bin iyiliği doğurur", "yardım etmek güçlü olmanın göstergesidir", "küçük bir yardım büyük bir fark yaratabilir"] },
    { eylem: "affet", hedefler: ["bir kırgınlığı", "bir hatayı", "bir ihaneti", "bir yanlış anlaşılmayı", "kendini", "geçmişi"], gerekceler: ["affetmek ilişkileri onarır", "affetmek karşıdaki için değil kendin içindir", "affetmek özgürleşmektir", "affetmek bir ilişkiyi yeniden inşa etmenin ilk adımıdır"] },
    { eylem: "dinle", hedefler: ["bir dostu", "bir şikayeti", "bir sevinci", "bir hikayeyi", "bir endişeyi", "bir hayali"], gerekceler: ["dinlemek sevginin en güçlü ifadesidir", "birini dinlemek ona değer verdiğini gösterir", "dinlemek anlamanın tek yoludur", "herkesin anlatacak bir hikayesi vardır"] },
  ];

  // Tüm kategorileri birleştir
  const tumKategoriler = [
    ...sosyalKategori,
    ...zihinselKategori,
    ...fizikselKategori,
    ...donusumKategori,
    ...bakimKategori,
    ...durgunlukKategori,
    ...maneviKategori,
    ...yaraticilikKategori,
    ...dogaKategori,
    ...iliskilerKategori,
  ];

  // Rastgele bir kategori öğesi seç
  const secili = tumKategoriler[Math.floor(rand() * tumKategoriler.length)];
  const hedef = secili.hedefler[Math.floor(rand() * secili.hedefler.length)];
  const gerekce = secili.gerekceler[Math.floor(rand() * secili.gerekceler.length)];

  // Farklı cümle kalıpları
  const kaliplar = [
    (eylem: string, hedef: string, gerekce: string) => `Bugün ${eylem} ${hedef}. Çünkü ${gerekce}.`,
    (eylem: string, hedef: string, gerekce: string) => `Bugün ${eylem} ${hedef} — ${gerekce}.`,
    (eylem: string, hedef: string, gerekce: string) => `Bugün için bir öneri: ${eylem} ${hedef}. ${gerekce}.`,
    (eylem: string, hedef: string, gerekce: string) => `Belki bugün ${eylem} ${hedef}. ${gerekce}.`,
    (eylem: string, hedef: string, gerekce: string) => `Bugün ${eylem} ${hedef} olsun. ${gerekce}.`,
    (eylem: string, hedef: string, gerekce: string) => `Bir an dur ve ${eylem} ${hedef}. ${gerekce}.`,
    (eylem: string, hedef: string, gerekce: string) => `Dene: ${eylem} ${hedef}. ${gerekce}.`,
    (eylem: string, hedef: string, gerekce: string) => `Hatırlatma: ${eylem} ${hedef}. ${gerekce}.`,
    (eylem: string, hedef: string, gerekce: string) => `Bugünkü çağrım: ${eylem} ${hedef}. ${gerekce}.`,
    (eylem: string, hedef: string, gerekce: string) => `${eylem} ${hedef}. ${gerekce}.`,
  ];

  const kalip = kaliplar[Math.floor(rand() * kaliplar.length)];
  let message = kalip(secili.eylem, hedef, gerekce);

  // Güvenlik kontrolü
  if (message.length > 250 || message.includes("undefined")) {
    message = "Bugün kendine iyi bak. Çünkü bunu yapacak başka kimse yok.";
  }

  return { message };
}

